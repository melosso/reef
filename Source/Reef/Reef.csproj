<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>Reef</RootNamespace>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <AssemblyTitle>Reef</AssemblyTitle>
    <AssemblyDescription>A lightweight data orchestration service</AssemblyDescription>
    <ApplicationIcon>logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Reef.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" IncludeAssets="runtime;build;native;contentfiles;analyzers" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="FluentFTP" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="MimeKit" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="NCrontab" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Scriban" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.EventLog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="exports\**" />
    <Content Remove="log\**" />
    <Content Remove=".core\**" />
  </ItemGroup>

  <PropertyGroup>
    <WebDir>$(MSBuildProjectDirectory)/../Reef.Web</WebDir>
  </PropertyGroup>

  <ItemGroup>
    <WebSource Include="$(WebDir)/src/**/*;$(WebDir)/index.html;$(WebDir)/package.json;$(WebDir)/package-lock.json;$(WebDir)/vite.config.ts" />
  </ItemGroup>

  <Target Name="BuildWeb" BeforeTargets="BeforeBuild" Condition="'$(SkipWebBuild)' != 'true' And Exists('$(WebDir)/package.json')" Inputs="@(WebSource)" Outputs="$(MSBuildProjectDirectory)/wwwroot/app/index.html">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(WebDir)" Condition="!Exists('$(WebDir)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
  </Target>

  <Target Name="IncludeWebOutput" AfterTargets="BuildWeb" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Content Remove="wwwroot/app/**" />
      <Content Include="wwwroot/app/**" />
    </ItemGroup>
  </Target>

</Project>